            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/profile/upload-image",
              "host": ["{{baseUrl}}"],
              "path": ["profile", "upload-image"]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "userId", "value": "{{userId}}", "type": "text" },
                { "key": "photo", "type": "file", "src": [] }
              ]
            }
          }
        },
        {
          "name": "Complete Profile Setup",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/profile/{{userId}}/setup",
              "host": ["{{baseUrl}}"],
              "path": ["profile", "{{userId}}", "setup"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Arjun Sharma\",\n  \"displayName\": \"Arjun\",\n  \"gender\": \"man\",\n  \"orientation\": \"straight\",\n  \"age\": 24,\n  \"dob\": \"2002-05-14\",\n  \"bio\": \"Software engineer in Bangalore.\",\n  \"language\": \"English, Hindi\",\n  \"appearance\": \"Athletic\",\n  \"bodyType\": \"Fit\",\n  \"height\": 178,\n  \"englishLevel\": \"Advanced\",\n  \"ethnicity\": \"Indian\",\n  \"lookingFor\": \"Relationship\",\n  \"smoke\": \"No\",\n  \"drink\": \"Socially\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Profile Completion Percentage",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/profile/completion?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["profile", "completion"],
              "query": [{ "key": "userId", "value": "{{userId}}" }]
            }
          }
        }
      ]
