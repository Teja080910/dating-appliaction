{
  "info": {
    "name": "AMARA Dating Application - API Collection",
    "_postman_id": "amara-api-collection-v1",
    "description": "Complete endpoint collection for the AMARA dating application covering all 10 feature modules.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.amara.com/api/v1",
      "type": "string"
    },
    {
      "key": "token",
      "value": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "usr_man_101",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication & Account Lifecycle",
      "item": [
        {
          "name": "Send OTP (Email)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/auth/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "send-otp"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"arjun@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": ["{{baseUrl}}"],
              "path": ["register"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Arjun Sharma\",\n  \"email\": \"arjun@example.com\",\n  \"password\": \"Password@123\",\n  \"confirmPassword\": \"Password@123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Verify Register OTP",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/verify-register/otp",
              "host": ["{{baseUrl}}"],
              "path": ["verify-register", "otp"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"arjun@example.com\",\n  \"otp\": \"123456\",\n  \"sessionId\": \"sess_reg_arjun_123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "User Login",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/login",
              "host": ["{{baseUrl}}"],
              "path": ["login"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"arjun@example.com\",\n  \"password\": \"Password@123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Forgot Password - Send OTP",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/forgot-password/send-otp",
              "host": ["{{baseUrl}}"],
              "path": ["forgot-password", "send-otp"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"arjun@example.com\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Forgot Password - Reset",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/forgot-password/reset",
              "host": ["{{baseUrl}}"],
              "path": ["forgot-password", "reset"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"arjun@example.com\",\n  \"otp\": \"123456\",\n  \"newPassword\": \"NewPassword@123\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Deactivate Account",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/account/deactivate?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["account", "deactivate"],
              "query": [{ "key": "userId", "value": "{{userId}}" }]
            }
          }
        },
        {
          "name": "Activate Account",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/account/activate?userId={{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["account", "activate"],
              "query": [{ "key": "userId", "value": "{{userId}}" }]
            }
          }
        },
        {
          "name": "Delete Account Permanently",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/account/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["account", "{{userId}}"]
            }
          }
        }
      ]
    },
    {
      "name": "2. Onboarding & Profile Setup",
      "item": [
        {
          "name": "Step 1: Gender Orientation",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/profile/gender-orientation",
              "host": ["{{baseUrl}}"],
              "path": ["profile", "gender-orientation"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{userId}}\",\n  \"gender\": \"man\",\n  \"orientation\": \"straight\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Step 3: Biometric Selfie Verification",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/profile/selfie/verify/{{userId}}",
              "host": ["{{baseUrl}}"],
